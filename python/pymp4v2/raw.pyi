MP4_CLOSE_DO_NOT_COMPUTE_BITRATE: int
MP4_CREATE_64BIT_DATA: int
MP4_CREATE_64BIT_TIME: int
MP4_OD_TRACK_TYPE: str
MP4_SCENE_TRACK_TYPE: str
MP4_AUDIO_TRACK_TYPE: str
MP4_VIDEO_TRACK_TYPE: str
MP4_HINT_TRACK_TYPE: str
MP4_CNTL_TRACK_TYPE: str
MP4_TEXT_TRACK_TYPE: str
