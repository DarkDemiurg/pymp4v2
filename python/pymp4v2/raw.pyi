class MP4TagArtworkType_e(enum.IntEnum):
    MP4_ART_UNDEFINED = ...
    MP4_ART_BMP = ...
    MP4_ART_GIF = ...
    MP4_ART_JPEG = ...
    MP4_ART_PNG = ...

MP4_ART_UNDEFINED: MP4TagArtworkType_e
MP4_ART_BMP: MP4TagArtworkType_e
MP4_ART_GIF: MP4TagArtworkType_e
MP4_ART_JPEG: MP4TagArtworkType_e
MP4_ART_PNG: MP4TagArtworkType_e

class MP4ChapterType(enum.IntEnum):
    MP4ChapterTypeNone = ...
    MP4ChapterTypeAny = ...
    MP4ChapterTypeQt = ...
    MP4ChapterTypeNero = ...

MP4ChapterTypeNone: MP4ChapterType
MP4ChapterTypeAny: MP4ChapterType
MP4ChapterTypeQt: MP4ChapterType
MP4ChapterTypeNero: MP4ChapterType

class MP4FileHandle:
    def __init__(self) -> None: ...
    def is_valid(self) -> bool: ...
    close_flags: int
    def close(self, flags: Optional[int] = None) -> None: ...
    def __enter__(self) -> MP4FileHandle: ...
    def __exit__(
        self,
        exc_type: Optional[type[BaseException]],
        exc: Optional[BaseException],
        tb: Optional[TracebackType],
    ) -> bool: ...

class MP4Sample:
    """One sample from MP4ReadSample: data (bytes) plus timing fields."""

    @property
    def data(self) -> bytes: ...
    startTime: int
    duration: int
    renderingOffset: int
    isSyncSample: bool
    def __iter__(self) -> Iterator[Union[bytes, int, bool]]: ...

class MP4TagArtwork:
    """Artwork item: data is a copy as bytes, type is MP4TagArtworkType."""

    @property
    def data(self) -> bytes: ...
    @property
    def size(self) -> int: ...
    type: MP4TagArtworkType_e

class MP4TagTrack:
    def __init__(self, index: int = ..., total: int = ...) -> None: ...
    index: int
    total: int

class MP4TagDisk:
    def __init__(self, index: int = ..., total: int = ...) -> None: ...
    index: int
    total: int

