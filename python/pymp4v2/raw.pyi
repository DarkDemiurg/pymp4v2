"""1:1 stubs for the bound subset of the MP4v2 C API.

C names are kept. Sample payloads and artwork are ``bytes``. C failures
(``false`` / ``MP4_INVALID_*``) raise ``MP4Error``, except predicates such as
``MP4HaveAtom``.
"""

from __future__ import annotations

import enum
from types import TracebackType
from typing import Iterator, Optional, Sequence, Union

from . import MP4Error as MP4Error

# Type aliases: ints at the C++ boundary and at runtime (not typing.NewType).
MP4TrackId = int
MP4SampleId = int
MP4Timestamp = int
MP4Duration = int
MP4EditId = int

MP4_INVALID_TRACK_ID: int
MP4_INVALID_SAMPLE_ID: int
